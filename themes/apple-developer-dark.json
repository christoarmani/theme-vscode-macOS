  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8C98",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FF7AB2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#F5F5F7"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FF8170"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D9C97C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.definition.variable",
        "variable.other.constant.declaration"
      ],
      "settings": {
        "foreground": "#4EB0CC"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#B281EB"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#DABAFF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#F5F5F7"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#78C2B3"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#F5F5F7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#CC9768"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF7AB2"
      }
    },
    {
      "scope": [
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D9C97C"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#FFA14F"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F5F5F7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.definition.heading",
        "punctuation.definition.list",
        "beginning.punctuation.definition.list",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F5F5F7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F5F5F7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#2997FF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#F5F5F7"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#30D158"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF6633"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#FF7AB2",
      "bold": true
    },
    "modifier": "#FF7AB2",
    "operator": "#F5F5F7",
    "string": "#FF8170",
    "regexp": "#FF8170",
    "number": "#D9C97C",
    "enumMember": "#78C2B3",
    "comment": {
      "foreground": "#7F8C98",
      "italic": true
    },
    "function": "#4EB0CC",
    "method": "#4EB0CC",
    "function.defaultLibrary": "#B281EB",
    "method.defaultLibrary": "#B281EB",
    "class": "#DABAFF",
    "struct": "#DABAFF",
    "enum": "#DABAFF",
    "interface": "#DABAFF",
    "type": "#DABAFF",
    "typeParameter": "#DABAFF",
    "namespace": "#DABAFF",
    "type.defaultLibrary": "#B281EB",
    "class.defaultLibrary": "#B281EB",
    "struct.defaultLibrary": "#B281EB",
    "variable": "#F5F5F7",
    "parameter": {
      "foreground": "#F5F5F7",
      "italic": true
    },
    "property": "#78C2B3",
    "macro": "#FFA14F",
    "decorator": "#CC9768",
    "variable.readonly": "#F5F5F7",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}