  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5F6D7A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#AD3DA4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#1D1D1F"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#C42B1C"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#272AD8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.definition.variable",
        "variable.other.constant.declaration"
      ],
      "settings": {
        "foreground": "#03638C"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#4B21B0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#703DAA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1D1D1F"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#2D6469"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#7A5D00"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#AD3DA4"
      }
    },
    {
      "scope": [
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#272AD8"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#78492A"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation.definition.heading",
        "punctuation.definition.list",
        "beginning.punctuation.definition.list",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#1D1D1F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#0066CC",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#636363"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#1D1D1F"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#007A00"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#CC3300"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#AD3DA4",
      "bold": true
    },
    "modifier": "#AD3DA4",
    "operator": "#1D1D1F",
    "string": "#C42B1C",
    "regexp": "#C42B1C",
    "number": "#272AD8",
    "enumMember": "#2D6469",
    "comment": {
      "foreground": "#5F6D7A",
      "italic": true
    },
    "function": "#03638C",
    "method": "#03638C",
    "function.defaultLibrary": "#4B21B0",
    "method.defaultLibrary": "#4B21B0",
    "class": "#703DAA",
    "struct": "#703DAA",
    "enum": "#703DAA",
    "interface": "#703DAA",
    "type": "#703DAA",
    "typeParameter": "#703DAA",
    "namespace": "#703DAA",
    "type.defaultLibrary": "#4B21B0",
    "class.defaultLibrary": "#4B21B0",
    "struct.defaultLibrary": "#4B21B0",
    "variable": "#1D1D1F",
    "parameter": {
      "foreground": "#1D1D1F",
      "italic": true
    },
    "property": "#2D6469",
    "macro": "#78492A",
    "decorator": "#7A5D00",
    "variable.readonly": "#1D1D1F",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}