  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#98989D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#BF5AF2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FF9F0A"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFD60A"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "variable.language"
      ],
      "settings": {
        "foreground": "#BF5AF2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#0A84FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#64D2FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E5E5EA"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E5E5EA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#DA8FFF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#64D2FF"
      }
    },
    {
      "scope": [
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FFD60A"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.other.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#FF9F0A"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0A84FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0A84FF"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF453A"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#BF5AF2",
      "bold": true
    },
    "modifier": "#BF5AF2",
    "operator": "#E5E5EA",
    "string": "#FF9F0A",
    "regexp": "#FF9F0A",
    "number": "#FFD60A",
    "enumMember": "#FFD60A",
    "comment": {
      "foreground": "#98989D",
      "italic": true
    },
    "function": "#0A84FF",
    "method": "#0A84FF",
    "member": "#0A84FF",
    "class": "#64D2FF",
    "struct": "#64D2FF",
    "enum": "#64D2FF",
    "interface": "#64D2FF",
    "type": "#64D2FF",
    "typeParameter": "#64D2FF",
    "namespace": "#64D2FF",
    "variable": "#E5E5EA",
    "parameter": {
      "foreground": "#E5E5EA",
      "italic": true
    },
    "property": "#E5E5EA",
    "macro": "#FF9F0A",
    "decorator": "#DA8FFF",
    "variable.readonly": "#FFD60A",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}