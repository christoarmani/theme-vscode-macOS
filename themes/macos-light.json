  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5D6C79",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#AD3DA4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D12F1B"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#272AD8"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "variable.language"
      ],
      "settings": {
        "foreground": "#AD3DA4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#804FB8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0B4F79"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#0F68A0"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#0F68A0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#804FB8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0B4F79"
      }
    },
    {
      "scope": [
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#272AD8"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "keyword.other.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#78492A"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#007AFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#007AFF"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF3B30"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": {
      "foreground": "#AD3DA4",
      "bold": true
    },
    "modifier": "#AD3DA4",
    "operator": "#0F68A0",
    "string": "#D12F1B",
    "regexp": "#D12F1B",
    "number": "#272AD8",
    "enumMember": "#272AD8",
    "comment": {
      "foreground": "#5D6C79",
      "italic": true
    },
    "function": "#804FB8",
    "method": "#804FB8",
    "member": "#804FB8",
    "class": "#0B4F79",
    "struct": "#0B4F79",
    "enum": "#0B4F79",
    "interface": "#0B4F79",
    "type": "#0B4F79",
    "typeParameter": "#0B4F79",
    "namespace": "#0B4F79",
    "variable": "#0F68A0",
    "parameter": {
      "foreground": "#0F68A0",
      "italic": true
    },
    "property": "#0F68A0",
    "macro": "#78492A",
    "decorator": "#804FB8",
    "variable.readonly": "#272AD8",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}